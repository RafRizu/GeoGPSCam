# Template konfigurasi signing key release untuk Google Play Store
# 1. Salin file ini menjadi 'key.properties' di folder android/
# 2. Buat keystore baru via command line:
#    keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# 3. Masukkan password dan path keystore di bawah ini:

keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
storeFile=upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
